# Игнорировать папку node_modules (зависимости npm)
node_modules/

# Игнорировать файлы окружения (например, .env)
.env

# Игнорировать логи
*.log

# Игнорировать системные файлы (например, .DS_Store на macOS)
.DS_Store

# Игнорировать папку для скачанных файлов (если она используется)
downloaded-files/

# Игнорировать временные файлы IDE (например, для Visual Studio Code)
.vscode/

# Игнорировать папку для скомпилированных файлов (если используется)
dist/
build/

# Игнорировать файлы npm
package-lock.json
npm-debug.log

# Игнорировать папку для тестовых данных (если используется)
test-data/